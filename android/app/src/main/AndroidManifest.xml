<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      mygo Android 宿主工程 Manifest

      【屏幕方向：允许旋转（2026-10-12 真机验证通过后解锁）】
      原选择是「锁竖屏」——旋转时系统不改配置 ⇒ Activity 不重建 ⇒ 首个宿主工程的
      验证变量最少，能先把「Go 侧渲染 + 事件转发」跑通，不被生命周期噪声干扰。
      真机上跑通「首帧 + 前后台 20 次 + 强制 Activity 重建 3 次」之后解锁：
      因为下面声明了 configChanges="orientation|..."，旋转**不会重建 Activity**，
      只走 surfaceChanged(w,h) 把新尺寸交给 Go 侧 —— 正是我们要的语义。
      （若哪天要测「旋转导致 Activity 重建」那条更狠的路径，把 configChanges 里的
       orientation 去掉即可，代价是每次旋转都重建。）

      【configChanges 的作用】
        screenSize / smallestScreenSize / screenLayout / density 这些**不改变方向**的
        配置变化（分屏、折叠屏展开、悬浮窗、字体/密度调整、显示尺寸改变）会频繁发生。
        声明它们后，Activity 不重建，Surface 只走 surfaceChanged(w,h)，正是我们要的
        「尺寸变化交给 Go 侧处理」的语义。

      【configChanges 里为什么有 orientation】
        有了它，方向变化不重建 Activity，只把新尺寸走 surfaceChanged(w,h) 给 Go 侧；
        没有它，每次旋转都重建 Activity（surfaceDestroyed→surfaceCreated），
        Go 侧虽然也能恢复（真机实测过），但会白白丢掉 EGL context 与渲染线程。
    -->
    <!-- T34: Android 13+ 发通知需要该运行时权限（缺它时 notify() 会被系统接受并丢弃） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- pprof 的调试服务器（lab 的 cmd/lab/pprof_android.go）要开一个
         127.0.0.1 的 socket，而 Android 10 起没有这个权限连 AF_INET 都建不了。
         它只绑回环，不接外网；release 包不带那个文件，所以这条也就没有用处，
         留着是因为 debug 包才需要它。 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:label="mygo"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">

        <activity
            android:name=".MygoActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- T34: 通知被点击时的回传接收方（org.mygo.MygoPlatform.NotificationReceiver） -->
        <receiver
            android:name=".MygoPlatform$NotificationReceiver"
            android:exported="false" />

    </application>

</manifest>
